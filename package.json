    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skill",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wechat",
    "公众号",
    "writing",
    "skill"
  ],
  "author": "zhuy3075-ui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuy3075-ui/dsh-plugin-wechat-writer.git"
  },
  "homepage": "https://github.com/zhuy3075-ui/dsh-plugin-wechat-writer#readme",
  "bugs": {
    "url": "https://github.com/zhuy3075-ui/dsh-plugin-wechat-writer/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
